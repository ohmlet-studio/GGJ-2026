[node name="DialogPrompt3" type="Node" parent="DialogController/Level1" unique_id=2010035605]
script = ExtResource("4_l8u7i")
char_dialog = "Bollocks, work sucks anyway, I'm glad you got out of it. Do you want me to throw a brick through their window ?"
response = "Yeah, that will show them."
input_sequence = "ANGER ANGER SAD HAPPY SAD HAPPY ANGER SURPRISE HAPPY HAPPY"
character = 6
