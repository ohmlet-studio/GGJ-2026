[node name="DialogPrompt2" type="Node" parent="DialogController/Levels/Level1" unique_id=1985790026]
script = ExtResource("4_l8u7i")
char_dialog = "Yeah, so I just got laid off, turns out you need to know how to count to be an engineer..."
